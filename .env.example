# ---------------------------------------------------------------------------
# Fun — environment configuration
# Copy to `.env` and adjust. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string used by web, worker, and Prisma CLI.
DATABASE_URL="postgresql://fun:fun@localhost:5432/fun"

# --- Application ------------------------------------------------------------
NODE_ENV=development
# Comma-separated emails granted the ADMIN role.
ADMIN_EMAILS="admin@example.com"
# Default user language: ru | en
DEFAULT_LANGUAGE=ru

# --- Security ---------------------------------------------------------------
# Long random string used to sign session-related values (generate: openssl rand -hex 32)
SESSION_SECRET="change-me-session-secret-generate-32-bytes"
# Max login/register attempts per 15 min window (raise for local dev / e2e).
AUTH_RATE_LIMIT=200

# --- Telegram ingestion (optional for dev; required for live collection) ----
# public | mtproto
#   public  (default): reads public t.me/s/<user> preview pages. NO login, NO keys.
#   mtproto: full-fidelity MTProto collection. Needs api_id/api_hash AND a one-time
#            `npm run tg:login` (saves the session into DATA_DIR/tg.session).
TELEGRAM_DRIVER=public
# Free api_id / api_hash from https://my.telegram.org/apps (mtproto driver only)
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""
# Directory where the MTProto session file is persisted (relative to repo root when
# running outside Docker; a mounted volume inside Docker).
DATA_DIR="./data"
# Ingestion interval for the fetch job, in minutes.
FETCH_INTERVAL_MINUTES=15
# How many of the latest posts to fetch per channel per run.
FETCH_LIMIT=25
# t.me connectivity is flaky (DNS/TCP drops in bursts); each channel is retried
# this many times (total attempts) with a delay between tries.
FETCH_RETRIES=3
FETCH_RETRY_DELAY_MS=15000

# --- AI (fully optional; app works with none) -------------------------------
# none | ollama
AI_PROVIDER=none
# off | light | full  — how much of the pipeline AI may refine
AI_MODE=off
# Local LLM endpoint (worker / Docker 'ai' profile).
OLLAMA_BASE_URL="http://localhost:11434"
# Recommended light models: qwen2.5:7b, gemma2:9b, llama3.1:8b
LOCAL_MODEL="qwen2.5:7b"

# --- Editions ----------------------------------------------------------------
# Comma-separated times (HH:MM, 24h, server timezone) to generate editions.
EDITION_TIMES="08:00,13:00,19:00"
# How many days of editions to retain.
ARCHIVE_RETENTION_DAYS=30
# How far back (hours) the edition selector should look for fresh stories.
EDITION_WINDOW_HOURS=12

# --- Media -------------------------------------------------------------------
# Local storage dir for downloaded Telegram photos (attribution preserved).
MEDIA_DIR="./data/media"

# --- Web ---------------------------------------------------------------------
# Port for the web app.
PORT=3000
# URL the browser uses to reach the web app (dev).
NEXT_PUBLIC_APP_URL="http://localhost:3000"