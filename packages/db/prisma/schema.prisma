// Fun — Prisma schema (PostgreSQL). Single source of truth for the database.
// Prisma ORM v7: datasource url moved to prisma.config.ts; client generated via
// the new `prisma-client` generator into ./generated/prisma.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

enum SessionPurpose {
  WEB
}

enum ChannelStatus {
  ACTIVE
  VALIDATING
  ERROR
  DISABLED
}

enum PostStatus {
  NEW
  NORMALIZED
  CLUSTERED
  DUPLICATE
  REJECTED
  ERROR
}

enum MediaKind {
  PHOTO
  VIDEO
  ANIMATION
  DOCUMENT
  AUDIO
}

enum StoryStatus {
  DRAFT
  ACCEPTED
  REJECTED
  ARCHIVED
}

enum EditionKind {
  MORNING
  AFTERNOON
  EVENING
}

enum EditionStatus {
  GENERATED
  FAILED
}

enum ArticleFormat {
  MAJOR
  STANDARD
  BRIEF
  FUNNY
  URGENT
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

// ---------------------------------------------------------------------------
// Accounts & security
// ---------------------------------------------------------------------------

model User {
  id           String              @id @default(cuid())
  email        String              @unique
  passwordHash String
  name         String?
  role         UserRole            @default(USER)
  language     String              @default("ru")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  sessions      Session[]
  subscriptions ChannelSubscription[]
  preferences   UserPreference?
  addedChannels Channel[]
}

model Session {
  id        String          @id @default(cuid())
  tokenHash String          @unique // sha256 of the opaque cookie token
  userId    String
  purpose   SessionPurpose  @default(WEB)
  expiresAt DateTime
  createdAt DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Content taxonomy
// ---------------------------------------------------------------------------

model Category {
  id               String  @id @default(cuid())
  key              String  @unique   // stable code e.g. "world", "tech"
  slug             String  @unique
  nameRu           String
  nameEn           String
  enabled          Boolean @default(true)
  isDefault        Boolean @default(false)
  importanceWeight Float   @default(1.0)
  sortOrder        Int     @default(0)

  channels Channel[]
  stories  Story[]

  @@index([enabled, sortOrder])
}

// ---------------------------------------------------------------------------
// Sources (Telegram channels)
// ---------------------------------------------------------------------------

model Channel {
  id               String        @id @default(cuid())
  telegramUsername String        @unique // without "@", lowercased
  title            String?
  description      String?
  avatarPath       String?
  avatarUrl        String?
  categoryId       String?
  category         Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  ownerUserId      String?       // who added this channel (null = editorial/base source)
  ownerUser        User?         @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  enabled          Boolean       @default(true)
  priority         Int           @default(5) // 1 = highest editorial priority
  isDefaultSource  Boolean       @default(false)
  status           ChannelStatus @default(ACTIVE)
  lastSyncAt       DateTime?
  lastError        String?
  postCount        Int           @default(0)
  qualityScore     Float         @default(0.5)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  posts         TelegramPost[]
  subscriptions ChannelSubscription[]

  @@index([enabled, priority])
  @@index([isDefaultSource])
  @@index([ownerUserId])
}

model ChannelSubscription {
  id        String   @id @default(cuid())
  userId    String
  channelId String
  weight    Int      @default(5) // 1..10 — how much of this source in My Newspaper
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@index([channelId])
}

// ---------------------------------------------------------------------------
// Raw ingestion
// ---------------------------------------------------------------------------

model TelegramPost {
  id              String     @id @default(cuid())
  channelId       String
  telegramMessageId Int
  raw             Json                 // verbatim Telegram payload — NEVER overwritten
  text            String     @default("")
  normalizedText  String     @default("")
  language        String?
  contentHash     String?              // dedup fingerprint
  status          PostStatus @default(NEW)
  isForwarded     Boolean    @default(false)
  forwardedFrom   String?
  views           Int?
  reactions       Json?                // { total: number, top: [{emoji,count}] }
  mediaCount      Int        @default(0)
  publishedAt     DateTime?            // Telegram message date
  fetchedAt       DateTime   @default(now())
  processedAt     DateTime?
  adScore         Float?               // 0..100
  spamScore       Float?               // 0..100
  importance      Int?                 // 0..100
  sentiment       Float?               // -1..1
  sentimentLabel  String?
  keywordTags     Json?

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  media   Media[]
  storyPosts StoryPost[]
  primaryFor   Story[] @relation("PrimaryPost")

  @@unique([channelId, telegramMessageId])
  @@index([contentHash])
  @@index([status, fetchedAt])
  @@index([publishedAt])
}

model Media {
  id            String    @id @default(cuid())
  telegramPostId String
  kind          MediaKind
  remoteId      String?
  localPath     String?
  mimeType      String?
  width         Int?
  height        Int?
  duration      Int?
  caption       String?
  attribution   String?  // e.g. "t.me/some_channel/123"
  createdAt     DateTime  @default(now())

  telegramPost TelegramPost @relation(fields: [telegramPostId], references: [id], onDelete: Cascade)

  @@index([telegramPostId])
}

// ---------------------------------------------------------------------------
// Editorial layer: stories (clusters) and articles (edition placement)
// ---------------------------------------------------------------------------

model Story {
  id               String      @id @default(cuid())
  categoryId       String?
  category         Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  headline         String      @default("")
  summary          String      @default("")
  longForm         String      @default("")
  generatedLanguage String     @default("ru")
  status           StoryStatus @default(DRAFT)
  importance       Int         @default(0)
  sentiment        Float?
  urgency          Boolean     @default(false)
  isFunny          Boolean     @default(false)
  isUncertain      Boolean     @default(false)
  confidence       Float?
  clusterHash      String?     @unique
  sourcesCount     Int         @default(1)
  primaryPostId    String?
  primaryPost      TelegramPost? @relation("PrimaryPost", fields: [primaryPostId], references: [id], onDelete: SetNull)
  firstPostAt      DateTime?
  lastPostAt       DateTime?
  featured         Boolean     @default(false)
  aiInfo           Json?       // provider, model, notes
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  posts    StoryPost[]
  articles Article[]

  @@index([status, importance])
  @@index([createdAt])
}

model StoryPost {
  id           String @id @default(cuid())
  storyId      String
  telegramPostId String
  contribution String @default("supporting") // primary | supporting

  story Story       @relation(fields: [storyId], references: [id], onDelete: Cascade)
  post  TelegramPost @relation(fields: [telegramPostId], references: [id], onDelete: Cascade)

  @@unique([storyId, telegramPostId])
  @@index([telegramPostId])
}

model Edition {
  id            String        @id @default(cuid())
  kind          EditionKind
  editionDate   DateTime      // calendar day start in server timezone
  label         String?
  publishedAt   DateTime?
  pageCount     Int           @default(0)
  configSnapshot Json?        // edition config used to build this edition
  status        EditionStatus @default(GENERATED)
  createdAt     DateTime      @default(now())

  articles Article[]

  @@unique([kind, editionDate])
  @@index([editionDate])
}

model Article {
  id              String        @id @default(cuid())
  editionId       String
  storyId         String?
  story           Story?        @relation(fields: [storyId], references: [id], onDelete: SetNull)
  page            Int
  pageOrder       Int           @default(0)
  section         String        // section slug e.g. "world", "light-reading"
  sectionIndex    Int           @default(0)
  format          ArticleFormat
  headline        String        @default("")
  summary         String        @default("")
  body            String        @default("")
  imageMediaId    String?       // optional reference to a Media row (no FK)
  headlineOverride String?
  summaryOverride  String?
  bodyOverride     String?
  manuallyEdited  Boolean       @default(false)
  featured        Boolean       @default(false)
  isUncertain     Boolean       @default(false)
  layout          Json?         // grid/column placement info
  aiInfo          Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  edition Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  sources ArticleSource[]

  @@index([editionId, page])
  @@index([section])
}

model ArticleSource {
  id              String  @id @default(cuid())
  articleId       String
  telegramPostId  String?
  channelName     String
  channelUsername String
  messageId       Int?
  url             String?

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

// ---------------------------------------------------------------------------
// Personalization
// ---------------------------------------------------------------------------

model UserPreference {
  id                  String   @id @default(cuid())
  userId              String   @unique
  language            String   @default("ru")
  enabledCategoryKeys Json?    // array of category keys enabled for "My Newspaper"
  humorEnabled        Boolean  @default(true)
  contentAmount       String   @default("normal") // light | normal | full
  geographicFocus     String?
  myNewspaperEnabled  Boolean  @default(false)
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Job bookkeeping (idempotency + observability)
// ---------------------------------------------------------------------------

model ProcessingJob {
  id           String    @id @default(cuid())
  type         String    // fetch, process-new-posts, cluster, generate-edition, cleanup, validate-channel
  resultKey    String?   @unique // unique scope key for idempotency
  status       JobStatus @default(PENDING)
  payload      Json?
  attemptCount Int       @default(0)
  maxAttempts  Int       @default(3)
  error        String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([type])
}